    font-weight:900;\
  \}\
\
  /* Daily goal row (8 cups) */\
  .goal-row\{\
    display:flex;\
    gap:10px;\
    justify-content:space-between;\
    align-items:flex-end;\
  \}\
  .mini-cups\{\
    display:flex;\
    gap:6px;\
    justify-content:center;\
    flex-wrap:nowrap;\
  \}\
  .mini\{\
    width:22px;\
    height:26px;\
