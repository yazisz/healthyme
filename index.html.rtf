  \}\
\
  /* Notch */\
  .notch\{\
    position:absolute;\
    top:10px;\
    left:50%;\
    transform:translateX(-50%);\
    width:150px;\
    height:26px;\
    border-radius:20px;\
    background:#0b1220;\
    opacity:.9;\
    z-index:5;\
  \}\
\
  /* App header */\
  .app\{\
    padding:40px 18px 18px;\
  \}\
  .title\{\
    display:flex;\
    align-items:center;\
    justify-content:center;\
    gap:8px;\
    font-weight:800;\
    letter-spacing:.2px;\
    font-size:22px;\
    margin:0;\
  \}\
  .subtitle\{\
    text-align:center;\
    margin:6px 0 16px;\
    color:var(--muted);\
    font-size:13px;\
  \}\
\
  /* Cards like the image */\
  .card\{\
    background: var(--card);\
    backdrop-filter: blur(6px);\
    border:1px solid #ffffff;\
    border-radius:18px;\
    padding:14px;\
    box-shadow: 0 8px 18px rgba(31,53,86,.08);\
  \}\
  .card + .card\{ margin-top:12px; \}\
\
  .card h2\{\
    margin:0 0 10px;\
    font-size:18px;\
    display:flex;\
    align-items:center;\
    gap:8px;\
  \}\
  .drop\{\
    width:22px;height:22px;\
    display:grid;place-items:center;\
    border-radius:9px;\
