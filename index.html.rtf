  .days-mini span\{ width:22px; text-align:center; \}\
\
  /* Weekly list like phone */\
  .week\{\
    display:flex;\
    flex-direction:column;\
    gap:10px;\
  \}\
  .row\{\
    display:flex;\
    align-items:center;\
    gap:10px;\
  \}\
  .daylabel\{\
    width:46px;\
    font-weight:700;\
    color:#31466b;\
  \}\
  .cups\{\
    display:flex;\
    gap:7px;\
    flex-wrap:nowrap;\
