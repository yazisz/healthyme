  \}\
</style>\
</head>\
\
<body>\
  <div class="phone">\
    <div class="screen">\
      <div class="notch"></div>\
\
      <div class="app">\
        <h1 class="title">HealthyMe <span aria-hidden="true">\uc0\u55357 \u56487 </span></h1>\
        <div class="subtitle">Track your daily water intake</div>\
\
        <div class="card">\
          <h2><span class="drop">\uc0\u55357 \u56487 </span>Daily Goal: <span id="goalText">8 Cups</span></h2>\
\
          <!-- Mini preview row (Mon..Sun) -->\
          <div class="mini-cups" id="miniCups"></div>\
          <div class="days-mini">\
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>\
          </div>\
\
          <div class="note">Tap a day above to edit that day below.</div>\
        </div>\
\
        <div class="card">\
          <h2>Weekly Tracker</h2>\
          <div class="week" id="week"></div>\
\
          <div class="actions">\
            <button class="primary" id="todayBtn">Go to Today</button>\
            <button id="resetBtn">Reset Week</button>\
          </div>\
        </div>\
\
        <div class="note">Progress is saved on this device (local storage).</div>\
      </div>\
    </div>\
  </div>\
\
<script>\
  const days = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];\
  const cupsPerDay = 8;\
\
  // Storage keys\
  const KEY = "healthyme_week_v1";\
  const SEL = "healthyme_selected_day_v1";\
\
  // Load or init data: \{ Mon: [bool x8], ... \}\
  let data = JSON.parse(localStorage.getItem(KEY)) || Object.fromEntries(\
    days.map(d => [d, Array(cupsPerDay).fill(false)])\
  );\
\
  // Selected day for editing (defaults to today)\
  const todayIndex = (() => \{\
    const js = new Date().getDay(); // Sun=0\
    return (js === 0) ? 6 : js - 1; // Mon=0..Sun=6\
  \})();\
\
  let selectedDay = localStorage.getItem(SEL) || days[todayIndex];\
\
  const miniCupsEl = document.getElementById("miniCups");\
  const weekEl = document.getElementById("week");\
  const resetBtn = document.getElementById("resetBtn");\
  const todayBtn = document.getElementById("todayBtn");\
\
  function save()\{\
    localStorage.setItem(KEY, JSON.stringify(data));\
    localStorage.setItem(SEL, selectedDay);\
  \}\
\
  function countFilled(day)\{\
    return data[day].filter(Boolean).length;\
  \}\
\
  function renderMini()\{\
    miniCupsEl.innerHTML = "";\
    days.forEach((d, idx) => \{\
      const filled = countFilled(d);\
      const mini = document.createElement("div");\
      mini.className = "mini" + (filled >= cupsPerDay ? " purple" : "");\
      if (filled > 0) mini.classList.add("filled");\
\
      // show selection ring\
      if (d === selectedDay) \{\
        mini.style.outline = "3px solid rgba(79,172,254,.55)";\
        mini.style.outlineOffset = "3px";\
      \}\
\
      mini.title = `$\{d\}: $\{filled\}/$\{cupsPerDay\} cups`;\
      mini.onclick = () => \{\
        selectedDay = d;\
        save();\
        render();\
      \};\
\
      miniCupsEl.appendChild(mini);\
    \});\
  \}\
\
  function renderWeek()\{\
    weekEl.innerHTML = "";\
    days.forEach((d) => \{\
      const row = document.createElement("div");\
      row.className = "row";\
\
      const label = document.createElement("div");\
      label.className = "daylabel";\
      label.textContent = d + ":";\
\
      const cups = document.createElement("div");\
      cups.className = "cups";\
\
      for (let i=0; i<cupsPerDay; i++)\{\
        const c = document.createElement("div");\
        c.className = "cup";\
\
        // Only allow clicking cups for selected day (matches \'93edit this day\'94 feel)\
        const clickable = (d === selectedDay);\
        c.style.opacity = clickable ? "1" : ".55";\
        c.style.pointerEvents = clickable ? "auto" : "none";\
\
        // filled state\
        if (data[d][i]) c.classList.add("filled");\
\
        // if day completed -> use purple style (like the image having color variation)\
        if (countFilled(d) >= cupsPerDay) c.classList.add("purple");\
\
        c.title = clickable ? "Tap to toggle" : `Select $\{d\} above to edit`;\
        c.onclick = () => \{\
          data[d][i] = !data[d][i];\
          save();\
          render();\
        \};\
\
        cups.appendChild(c);\
      \}\
\
      // Highlight the selected day row\
      if (d === selectedDay)\{\
        row.style.padding = "10px";\
        row.style.borderRadius = "16px";\
        row.style.background = "rgba(255,255,255,.55)";\
        row.style.border = "1px solid rgba(255,255,255,.8)";\
      \}\
\
      row.appendChild(label);\
      row.appendChild(cups);\
      weekEl.appendChild(row);\
    \});\
  \}\
\
  function render()\{\
    renderMini();\
    renderWeek();\
  \}\
\
  resetBtn.onclick = () => \{\
    if (!confirm("Reset the whole week?")) return;\
    days.forEach(d => data[d] = Array(cupsPerDay).fill(false));\
    save();\
    render();\
  \};\
\
  todayBtn.onclick = () => \{\
    selectedDay = days[todayIndex];\
    save();\
    render();\
  \};\
\
  render();\
</script>\
</body>\
</html>\
}