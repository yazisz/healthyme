    height:30px;\
    border-radius:9px;\
    border:2px solid var(--stroke);\
    background:#ffffffa6;\
    cursor:pointer;\
    transition: transform .12s ease, box-shadow .12s ease;\
  \}\
  .cup:hover\{\
    transform: translateY(-1px) scale(1.03);\
    box-shadow: 0 6px 14px rgba(47,108,210,.12);\
  \}\
  .cup.filled\{\
    border-color: transparent;\
    background: linear-gradient(135deg, #4facfe, #43e97b);\
  \}\
  .cup.purple.filled\{\
    background: linear-gradient(135deg, #8b5cf6, #ec4899);\
  \}\
\
  /* Footer buttons */\
  .actions\{\
    display:flex;\
    gap:10px;\
    margin-top:12px;\
  \}\
  button\{\
    flex:1;\
    border:none;\
    border-radius:14px;\
    padding:10px 12px;\
    font-weight:700;\
    cursor:pointer;\
    color:#0b1b33;\
    background:#ffffffcc;\
    box-shadow: 0 8px 18px rgba(31,53,86,.08);\
  \}\
  button.primary\{\
    color:white;\
    background: linear-gradient(135deg, #4facfe, #43e97b);\
  \}\
\
  .note\{\
    text-align:center;\
    margin-top:10px;\
    font-size:12px;\
